---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Signals from '../components/Signals.astro';
import Approach from '../components/Approach.astro';
import HowItWorks from '../components/HowItWorks.astro';
import Plans from '../components/Plans.astro';
import AboutTeacher from '../components/AboutTeacher.astro';
import ForWhom from '../components/ForWhom.astro';
import Testimonials from '../components/Testimonials.astro';
import VideoSection from '../components/VideoSection.astro';
import Gallery from '../components/Gallery.astro';
import FAQ from '../components/FAQ.astro';
import FinalCTA from '../components/FinalCTA.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';

import { navigation } from '../data/navigation';
import { testimonials } from '../data/testimonials';
import { videos } from '../data/videos';

// Itens de menu de seções sem conteúdo são ocultados automaticamente.
const available = {
  testimonials: testimonials.some((t) => t.name.trim() && t.text.trim()),
  videos: videos.length > 0,
};
const navItems = navigation.filter((item) => !item.requires || available[item.requires]);
---

<BaseLayout>
  <Header items={navItems} />
  <main id="conteudo">
    <Hero />
    <Signals />
    <Approach />
    <HowItWorks />
    <Plans />
    <AboutTeacher />
    <ForWhom />
    <Testimonials />
    <VideoSection />
    <Gallery />
    <FAQ />
    <FinalCTA />
    <Contact />
  </main>
  <Footer items={navItems} />
  <WhatsAppButton />
  <StickyMobileCTA />
</BaseLayout>

<script>
  import '../scripts/reveal';
</script>
