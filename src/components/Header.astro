---
import Logo from './Logo.astro';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
import type { NavItem } from '../data/navigation';
import { primaryContact, primaryContactLabel } from '../utils/contact';

interface Props {
  items: NavItem[];
}

const { items } = Astro.props;
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <Logo />

    <nav class="site-nav" aria-label="Navegação principal">
      <ul class="site-nav__list" id="menu-principal" data-menu>
        {
          items.map((item) => (
            <li>
              <a href={item.href} class="site-nav__link" data-nav-link>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="site-nav__mobile-cta">
          <Button href={primaryContact.href} external={primaryContact.external} data-nav-link>
            {primaryContactLabel}
          </Button>
        </li>
      </ul>
    </nav>

    <div class="site-header__actions">
      <Button href={primaryContact.href} external={primaryContact.external} size="sm" class="site-header__cta">
        {primaryContactLabel}
      </Button>
      <button
        type="button"
        class="menu-toggle"
        aria-controls="menu-principal"
        aria-expanded="false"
        aria-label="Abrir menu"
        data-menu-toggle
      >
        <span class="menu-toggle__open"><Icon name="menu" size={26} /></span>
        <span class="menu-toggle__close"><Icon name="x" size={26} /></span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const links = document.querySelectorAll<HTMLAnchorElement>('[data-nav-link]');
  const mobileQuery = window.matchMedia('(max-width: 1199px)');

  const setOpen = (open: boolean) => {
    if (!toggle || !header) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
    header.classList.toggle('is-open', open);
    document.body.classList.toggle('no-scroll', open);
  };

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  links.forEach((link) => link.addEventListener('click', () => setOpen(false)));

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && header?.classList.contains('is-open')) {
      setOpen(false);
      toggle?.focus();
    }
  });
  mobileQuery.addEventListener('change', (e) => !e.matches && setOpen(false));

  // Destaca o item do menu correspondente à seção visível
  const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.site-nav__link'));
  const sections = navLinks
    .map((link) => document.querySelector<HTMLElement>(link.hash))
    .filter((el): el is HTMLElement => el !== null);

  if ('IntersectionObserver' in window && sections.length) {
    const spy = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          navLinks.forEach((link) => {
            const active = link.hash === `#${entry.target.id}`;
            link.classList.toggle('is-active', active);
            if (active) link.setAttribute('aria-current', 'true');
            else link.removeAttribute('aria-current');
          });
        });
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((section) => spy.observe(section));
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--header-h);
    background: var(--papel);
    border-bottom: 1px solid var(--pauta);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 100%;
  }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: 0.1rem;
    list-style: none;
  }

  .site-nav__link {
    display: block;
    padding: 0.5rem 0.6rem;
    font-size: 0.95rem;
    color: var(--grafite);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav__link:hover {
    color: var(--caneta);
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .site-nav__link.is-active {
    color: var(--caneta);
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .site-nav__mobile-cta {
    display: none;
  }

  .site-header__actions :global(.btn) {
    white-space: nowrap;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .menu-toggle {
    display: none;
    place-items: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 1px solid var(--pauta-forte);
    border-radius: var(--raio-botao);
    background: transparent;
    color: var(--grafite);
  }

  .menu-toggle__close {
    display: none;
  }

  .is-open .menu-toggle__open {
    display: none;
  }

  .is-open .menu-toggle__close {
    display: block;
  }

  /* Telas menores: menu em lista */
  @media (max-width: 1199px) {
    .menu-toggle {
      display: grid;
    }

    .site-nav__list {
      position: fixed;
      inset: var(--header-h) 0 auto 0;
      max-height: calc(100dvh - var(--header-h));
      overflow-y: auto;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem var(--gutter) 1.5rem;
      background: var(--papel);
      border-bottom: 1px solid var(--pauta);
      visibility: hidden;
    }

    .is-open .site-nav__list {
      visibility: visible;
    }

    .site-nav__list li:not(.site-nav__mobile-cta) {
      border-bottom: 1px solid var(--pauta);
    }

    .site-nav__link {
      padding: 0.85rem 0.25rem;
      font-size: 1.05rem;
    }

    .site-nav__mobile-cta {
      display: block;
      margin-top: 1.25rem;
    }

    .site-nav__mobile-cta :global(.btn) {
      width: 100%;
    }
  }

  @media (max-width: 520px) {
    .site-header :global(.site-header__cta) {
      display: none;
    }
  }

  @media (min-width: 1200px) and (max-width: 1320px) {
    .site-nav__link {
      padding-inline: 0.45rem;
      font-size: 0.9rem;
    }
  }
</style>
