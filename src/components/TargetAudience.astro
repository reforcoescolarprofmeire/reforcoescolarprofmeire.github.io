---
import Section from './ui/Section.astro';
import { audienceSection as data } from '../data/audience';
import { hasValue } from '../utils/contact';
---

<Section id="para-quem">
  <div class="audience">
    <div>
      <h2 id="para-quem-titulo" class="section-title">{data.title}</h2>
      <p class="section-intro">{data.intro}</p>

      <p class="audience__groups">
        <span class="sr-only">Faixas atendidas: </span>
        {data.groups.join(' · ')}
      </p>
      {hasValue(data.grades) && <p class="audience__grades">{data.grades}</p>}
    </div>

    <ul class="lista-traco audience__list">
      {data.items.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</Section>

<style>
  .audience {
    display: grid;
    gap: 2rem;
  }

  .audience__groups {
    margin: 1.5rem 0 0;
    font-weight: 700;
    color: var(--caneta);
  }

  .audience__grades {
    margin: 0.5rem 0 0;
    font-weight: 700;
  }

  @media (min-width: 1100px) {
    .audience {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 3rem;
      align-items: end;
    }
  }
</style>
