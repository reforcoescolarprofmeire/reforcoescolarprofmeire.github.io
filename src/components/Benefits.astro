---
import Section from './ui/Section.astro';
import SectionHeader from './ui/SectionHeader.astro';
import Icon from './ui/Icon.astro';
import { benefitsSection as data } from '../data/benefits';

const tones = ['', 'icon-badge--green', 'icon-badge--yellow'];
---

<Section id="beneficios" tone="cream">
  <SectionHeader id="beneficios-titulo" eyebrow={data.eyebrow} title={data.title} intro={data.intro} />

  <ul class="benefits">
    {
      data.items.map((item, i) => (
        <li class="benefit card card--hover reveal" style={`--delay:${(i % 5) * 60}ms`}>
          <span class:list={['icon-badge', tones[i % 3]]}>
            <Icon name={item.icon} size={22} />
          </span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .benefits {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 210px), 1fr));
    gap: 1rem;
    list-style: none;
  }

  .benefit {
    padding: 1.5rem 1.35rem;
  }

  .benefit .icon-badge {
    margin-bottom: 1rem;
  }

  .benefit h3 {
    font-size: 1.1rem;
    margin-bottom: 0.35rem;
  }

  .benefit p {
    margin: 0;
    font-size: 0.975rem;
    color: var(--color-muted);
  }

  @media (min-width: 481px) and (max-width: 1099px) {
    .benefits {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .benefits {
      grid-template-columns: repeat(5, 1fr);
    }
  }
</style>
