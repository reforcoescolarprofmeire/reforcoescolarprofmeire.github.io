---
import Section from './ui/Section.astro';
import SectionHeader from './ui/SectionHeader.astro';
import { benefitsSection as data } from '../data/benefits';
---

<Section id="beneficios">
  <SectionHeader id="beneficios-titulo" title={data.title} intro={data.intro} />

  <dl class="definicoes definicoes--2">
    {
      data.items.map((item) => (
        <div>
          <dt>{item.title}</dt>
          <dd>{item.text}</dd>
        </div>
      ))
    }
  </dl>
</Section>
