---
import { siteConfig } from '../config/site';

interface Props {
  variant?: 'default' | 'light';
}

const { variant = 'default' } = Astro.props;
---

<a href="#inicio" class:list={['logo', `logo--${variant}`]}>
  <svg class="logo__mark" width="44" height="44" viewBox="0 0 44 44" aria-hidden="true" focusable="false">
    <rect width="44" height="44" rx="13" fill="#215b98" />
    <path d="M10 15.5c3.8-1.4 7.6-1.2 11 1.2v14c-3.4-2.3-7.2-2.5-11-1.2z" fill="#fff" />
    <path d="M34 15.5c-3.8-1.4-7.6-1.2-11 1.2v14c3.4-2.3 7.2-2.5 11-1.2z" fill="#dff2e8" />
    <path d="m31.5 6.5 1.1 2.3 2.5.4-1.8 1.8.4 2.5-2.2-1.2-2.3 1.2.5-2.5-1.8-1.8 2.5-.4z" fill="#f2b632" />
  </svg>
  <span class="logo__text">
    <span class="logo__top">{siteConfig.shortName}</span>
    <span class="logo__name">{siteConfig.teacher}</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--ink-900);
    flex-shrink: 0;
  }

  .logo__mark {
    flex-shrink: 0;
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .logo__top {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green-700);
  }

  .logo__name {
    font-family: var(--font-heading);
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .logo--light {
    color: var(--white);
  }

  .logo--light .logo__top {
    color: var(--yellow-300);
  }
</style>
