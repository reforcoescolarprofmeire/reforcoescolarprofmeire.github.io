---
import { siteConfig } from '../config/site';
---

<a href="#inicio" class="logo">
  <span class="logo__mark" aria-hidden="true">M</span>
  <span class="logo__text">
    <span class="logo__top">{siteConfig.shortName}</span>
    <span class="logo__name">{siteConfig.teacher}</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--grafite);
    flex-shrink: 0;
  }

  .logo__mark {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 2px solid var(--caneta);
    color: var(--caneta);
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1;
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .logo__top {
    font-size: 0.85rem;
    color: var(--grafite-suave);
  }

  .logo__name {
    font-size: 1.1rem;
    font-weight: 700;
  }
</style>
