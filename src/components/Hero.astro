---
import Button from './ui/Button.astro';
import Anotacao from './ui/Anotacao.astro';
import { hero } from '../data/hero';
import { primaryContact, primaryContactLabel } from '../utils/contact';

// Traços da professora, desenhados à mão
const tracos = {
  circulo: { viewBox: '0 0 100 40', d: 'M90 11C79 2 33 0 13 7-3 13 1 31 22 36c24 5 63 3 73-8 6-7 1-16-13-21' },
  risco: { viewBox: '0 0 40 40', d: 'M6 36 34 4' },
};
---

<section id="inicio" class="hero" aria-labelledby="inicio-titulo">
  <div class="container folha hero__folha">
    <fieldset class="etapas">
      <legend class="etapas__legenda">Veja uma correção de exemplo</legend>
      <div class="etapas__opcoes">
        {
          hero.exercises.map((ex, i) => (
            <label class="etapas__opcao">
              <input type="radio" name="etapa" value={ex.id} id={`etapa-${ex.id}`} checked={i === 0} />
              <span>{ex.etapa}</span>
            </label>
          ))
        }
      </div>
    </fieldset>

    {
      hero.exercises.map((ex) => {
        let ordem = 0;
        return (
          <div class="com-nota exercicio" data-etapa={ex.id}>
            <p class="exercicio__rotulo">
              {ex.disciplina} · {ex.etapa}
            </p>
            <p class="exercicio__enunciado">{ex.enunciado}</p>
            <div class="exercicio__resposta">
              {ex.resposta.map((linha) => (
                <p>
                  {linha.map((parte) => {
                    if (typeof parte === 'string') return parte;
                    const t = tracos[parte.marca];
                    const atraso = 0.4 + ordem++ * 0.6;
                    return (
                      <span class:list={['marca', `marca--${parte.marca}`]}>
                        {parte.texto}
                        <svg viewBox={t.viewBox} preserveAspectRatio="none" aria-hidden="true" focusable="false">
                          <path d={t.d} pathLength="1" style={`--atraso:${atraso}s`} />
                        </svg>
                      </span>
                    );
                  })}
                </p>
              ))}
            </div>
            <p class="sr-only">Correção: {ex.descricao}</p>
            <Anotacao top={ex.notaTop} class="exercicio__nota">
              {ex.nota.regra}
              <span class="exercicio__correto">{ex.nota.correto}</span>
            </Anotacao>
          </div>
        );
      })
    }

    <div class="hero__texto">
      <h1 id="inicio-titulo" class="hero__title">{hero.title}</h1>
      <p class="hero__subtitle">{hero.subtitle}</p>

      <div class="hero__actions">
        <Button href={primaryContact.href} external={primaryContact.external} size="lg">
          {primaryContactLabel}
        </Button>
        <a href={hero.secondaryCta.href} class="hero__link">{hero.secondaryCta.label}</a>
      </div>

      <ul class="hero__highlights lista-traco lista-traco--2" aria-label="Diferenciais do reforço">
        {hero.highlights.map((item) => <li>{item.text}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero__folha {
    padding-block: clamp(1.75rem, 1.25rem + 2.5vw, 3.5rem) var(--space-section);
  }

  /* Seletor de etapa */
  .etapas {
    margin: 0 0 1.75rem;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .etapas__legenda {
    padding: 0;
    margin-bottom: 0.6rem;
    font-size: var(--t--1);
    color: var(--grafite-suave);
  }

  .etapas__opcoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .etapas__opcao {
    position: relative;
    cursor: pointer;
  }

  .etapas__opcao input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .etapas__opcao span {
    display: block;
    min-height: 44px;
    padding: 0.6rem 1rem;
    border: 1px solid var(--pauta-forte);
    border-radius: var(--raio-botao);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--grafite);
  }

  .etapas__opcao:hover span {
    border-color: var(--caneta);
    color: var(--caneta);
  }

  .etapas__opcao input:checked + span {
    background: var(--caneta);
    border-color: var(--caneta);
    color: var(--sobre-caneta);
  }

  .etapas__opcao input:focus-visible + span {
    outline: 3px solid var(--caneta);
    outline-offset: 3px;
  }

  /* Exercícios: só o da etapa escolhida aparece (sem JavaScript) */
  .exercicio {
    display: none;
    max-width: 40rem;
  }

  .hero:has(#etapa-fund1:checked) [data-etapa='fund1'],
  .hero:has(#etapa-fund2:checked) [data-etapa='fund2'],
  .hero:has(#etapa-medio:checked) [data-etapa='medio'] {
    display: block;
  }

  @supports not selector(:has(*)) {
    [data-etapa='fund1'] {
      display: block;
    }

    .etapas {
      display: none;
    }
  }

  .exercicio__rotulo {
    margin: 0 0 0.25rem;
    font-size: var(--t--1);
    color: var(--grafite-suave);
  }

  .exercicio__enunciado {
    margin: 0;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--pauta);
    font-weight: 700;
  }

  .exercicio__resposta {
    padding-top: 0.6rem;
    font-size: var(--t-2);
    line-height: 1.75;
    color: var(--caneta);
  }

  .exercicio__resposta p {
    margin: 0;
  }

  .marca {
    position: relative;
    display: inline-block;
    white-space: nowrap;
  }

  .marca svg {
    position: absolute;
    inset: -0.2em -0.35em -0.1em;
    width: calc(100% + 0.7em);
    height: calc(100% + 0.3em);
    max-width: none;
    overflow: visible;
    pointer-events: none;
  }

  .marca--risco svg {
    inset: 0.15em -0.15em 0.1em;
    width: calc(100% + 0.3em);
    height: calc(100% - 0.25em);
  }

  .marca path {
    fill: none;
    stroke: var(--correcao);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .exercicio :global(.exercicio__nota) {
    margin-top: 1rem;
  }

  .exercicio__correto {
    display: block;
    margin-top: 0.3rem;
  }

  /* Texto */
  .hero__texto {
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .hero__title {
    font-size: var(--t-5);
    line-height: 1.1;
    max-width: 18ch;
    margin-bottom: 1rem;
  }

  .hero__subtitle {
    font-size: var(--t-1);
    line-height: 1.5;
    max-width: 54ch;
    margin-bottom: 1.75rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-bottom: 2.25rem;
  }

  .hero__link {
    font-weight: 700;
  }

  .hero__highlights {
    max-width: 40rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--pauta);
    color: var(--grafite-suave);
    font-size: 0.975rem;
  }

  @media (min-width: 960px) {
    .exercicio :global(.exercicio__nota) {
      margin-top: 0;
      font-size: 1.25rem;
    }
  }

  @media (max-width: 520px) {
    .hero__actions :global(.btn) {
      width: 100%;
    }

    .etapas__opcoes {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .etapas__opcao:last-child {
      grid-column: 1 / -1;
    }
  }

  /* Única animação automática: a correção toca ao carregar a página e de novo
     quando o usuário troca de etapa (o exercício volta a ser exibido).
     Com movimento reduzido, o estado corrigido já aparece pronto. */
  @media (prefers-reduced-motion: no-preference) {
    .marca path {
      stroke-dasharray: 1;
      animation: desenhar 0.6s ease-out var(--atraso, 0.4s) both;
    }

    .marca--risco path {
      animation-duration: 0.3s;
    }

    .exercicio :global(.exercicio__nota) {
      animation: aparecer 0.5s ease-out 1.5s both;
    }
  }

  @keyframes desenhar {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes aparecer {
    from {
      opacity: 0;
    }
  }
</style>
