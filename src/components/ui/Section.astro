---
interface Props {
  id: string;
  tone?: 'white' | 'blue' | 'green' | 'cream';
  class?: string;
  labelledby?: string;
}

const { id, tone = 'white', class: className, labelledby = `${id}-titulo` } = Astro.props;
---

<section id={id} class:list={['section', `section--${tone}`, className]} aria-labelledby={labelledby}>
  <div class="container">
    <slot />
  </div>
</section>
