---
interface Props {
  id: string;
  class?: string;
  labelledby?: string;
}

const { id, class: className, labelledby = `${id}-titulo` } = Astro.props;
---

<section id={id} class:list={['section', className]} aria-labelledby={labelledby}>
  <div class="container folha">
    <slot />
  </div>
</section>
