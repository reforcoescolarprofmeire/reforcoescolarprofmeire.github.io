icons['star-fill'] = icons.star;

const body = icons[name];
if (!body) console.warn(`[Icon] ícone não encontrado: ${name}`);
---

{
  body && (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill={name === 'star-fill' ? 'currentColor' : 'none'}
      stroke="currentColor"
      stroke-width={strokeWidth}
      stroke-linecap="round"
      stroke-linejoin="round"
      class:list={['icon', className]}
      aria-hidden={label ? undefined : 'true'}
      role={label ? 'img' : undefined}
      aria-label={label}
      focusable="false"
      set:html={body}
    />
  )
}
