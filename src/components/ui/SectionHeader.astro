---
interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  intro?: string;
  align?: 'center' | 'start';
}

const { id, eyebrow, title, intro, align = 'center' } = Astro.props;
---

<header class:list={['section-header', `section-header--${align}`, 'reveal']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id} class="section-title">{title}</h2>
  {intro && <p class="section-intro">{intro}</p>}
</header>
