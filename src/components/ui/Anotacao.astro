---
/**
 * Anotação do professor: texto em Kalam, na cor de correção.
 * Use dentro de um elemento .com-nota, logo depois do trecho a que se refere.
 * No computador ela vai para a margem; no celular fica abaixo do trecho.
 * `top` ajusta a altura na margem (ex.: "2.5rem").
 */
interface Props {
  top?: string;
  seta?: boolean;
  class?: string;
}

const { top, seta = true, class: className } = Astro.props;
---

<p class:list={['anotacao', className]} style={top ? `--nota-top:${top}` : undefined}>
  {
    seta && (
      <svg class="anotacao__seta" viewBox="0 0 30 22" aria-hidden="true" focusable="false">
        <path
          d="M28 17c-6 2.5-15 2-21-6.5M7 10.5l.6 6.4M7 10.5l6.1 1.4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    )
  }
  <span><slot /></span>
</p>
