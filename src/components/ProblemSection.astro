---
import Section from './ui/Section.astro';
import SectionHeader from './ui/SectionHeader.astro';
import Grifado from './ui/Grifado.astro';
import { problemsSection as data } from '../data/problems';
---

<Section id="dificuldades">
  <SectionHeader id="dificuldades-titulo" title={data.title} intro={data.intro} />

  <ul class="problems lista-traco lista-traco--2">
    {data.items.map((item) => <li>{item.text}</li>)}
  </ul>

  <p class="problems__closing">
    <Grifado texto={data.closing} trecho="estudar pode se tornar muito mais simples" />
  </p>
</Section>

<style>
  .problems {
    max-width: 52rem;
  }

  .problems__closing {
    margin: clamp(2rem, 1.5rem + 2vw, 2.75rem) 0 0;
    font-size: var(--t-1);
    line-height: 1.5;
    max-width: 46ch;
  }
</style>
