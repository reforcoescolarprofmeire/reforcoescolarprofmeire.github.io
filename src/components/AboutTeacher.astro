---
import { Image } from 'astro:assets';
import Section from './ui/Section.astro';
import Anotacao from './ui/Anotacao.astro';
import { teacher } from '../data/teacher';

// Blocos de credenciais: só aparecem os que tiverem itens cadastrados.
const credentials = [
  { title: 'Formação', items: teacher.education },
  { title: 'Experiência', items: teacher.experience },
  { title: 'Cursos', items: teacher.courses },
  { title: 'Especializações', items: teacher.specializations },
].filter((block) => block.items.length > 0);
---

<Section id="sobre">
  <div class="about">
    <div class="about__media">
      <Image
        src={teacher.portrait.src}
        alt={teacher.portrait.alt}
        widths={[400, 600, 800]}
        sizes="(min-width: 960px) 300px, (min-width: 560px) 260px, 92vw"
        class="about__img"
      />

      {
        teacher.moments.length > 0 && (
          <figure class="about__moments">
            <ul>
              {teacher.moments.map((photo) => (
                <li>
                  <Image
                    src={photo.src}
                    alt={photo.alt}
                    width={128}
                    height={128}
                    style={`object-position:${photo.position}`}
                  />
                </li>
              ))}
            </ul>
            <figcaption>{teacher.momentsCaption}</figcaption>
          </figure>
        )
      }
    </div>

    <div class="about__content">
      <h2 id="sobre-titulo" class="section-title">{teacher.title}</h2>
      {
        teacher.paragraphs.map((text, i) =>
          i === teacher.paragraphs.length - 1 ? (
            <div class="com-nota">
              <p class="about__text">{text}</p>
              <Anotacao top="0.4rem">conversa com a família em cada etapa</Anotacao>
            </div>
          ) : (
            <p class="about__text">{text}</p>
          ),
        )
      }

      <dl class="definicoes about__values">
        {
          teacher.values.map((value) => (
            <div>
              <dt>{value.title}</dt>
              <dd>{value.text}</dd>
            </div>
          ))
        }
      </dl>

      {
        credentials.length > 0 && (
          <dl class="definicoes about__credentials">
            {credentials.map((block) => (
              <div>
                <dt>{block.title}</dt>
                <dd>
                  <ul class="lista-traco">
                    {block.items.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </div>
</Section>

<style>
  .about {
    display: grid;
    gap: clamp(2rem, 1.5rem + 2vw, 3rem);
    align-items: start;
  }

  .about__media {
    max-width: 300px;
  }

  .about__img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 40%;
  }

  .about__moments {
    margin: 1rem 0 0;
  }

  .about__moments ul {
    display: flex;
    gap: 0.5rem;
    list-style: none;
  }

  .about__moments img {
    width: 64px;
    height: 64px;
    object-fit: cover;
  }

  .about__moments figcaption {
    margin-top: 0.4rem;
    font-size: var(--t--1);
    color: var(--grafite-suave);
  }

  .about__text {
    max-width: 62ch;
  }

  .about__values {
    margin-top: 1.5rem;
  }

  .about__credentials {
    margin-top: 1.5rem;
  }

  @media (min-width: 560px) {
    .about {
      grid-template-columns: minmax(200px, 260px) 1fr;
    }
  }

  @media (min-width: 960px) {
    .about {
      grid-template-columns: 260px 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 559px) {
    .about__media {
      max-width: 240px;
    }
  }
</style>
