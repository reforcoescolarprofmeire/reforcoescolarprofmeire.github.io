---
import { Image } from 'astro:assets';
import Section from './ui/Section.astro';
import Icon from './ui/Icon.astro';
import { teacher } from '../data/teacher';

// Blocos de credenciais: só aparecem os que tiverem itens cadastrados.
const credentials = [
  { title: 'Formação', icon: 'graduation-cap', items: teacher.education },
  { title: 'Experiência', icon: 'briefcase', items: teacher.experience },
  { title: 'Cursos', icon: 'book-open', items: teacher.courses },
  { title: 'Especializações', icon: 'award', items: teacher.specializations },
].filter((block) => block.items.length > 0);
---

<Section id="sobre" tone="blue">
  <div class="about">
    <div class="about__media reveal">
      {
        teacher.portrait ? (
          <div class="about__photo">
            <Image
              src={teacher.portrait.src}
              alt={teacher.portrait.alt}
              widths={[400, 600, 800]}
              sizes="(min-width: 1024px) 460px, 90vw"
              class="about__img"
            />
          </div>
        ) : (
          <div class="about__card">
            <span class="about__initials" aria-hidden="true">{teacher.initials}</span>
            <p class="about__card-name">{teacher.name}</p>
            <p class="about__card-role">{teacher.role}</p>
            <ul class="about__stats">
              <li><strong>+30</strong><span>anos de experiência</span></li>
              <li><strong>Psico&shy;pedagogia</strong><span>especialização</span></li>
            </ul>
          </div>
        )
      }

      {
        teacher.moments.length > 0 && (
          <figure class="about__moments">
            <ul>
              {teacher.moments.map((photo) => (
                <li>
                  <Image
                    src={photo.src}
                    alt={photo.alt}
                    width={128}
                    height={128}
                    style={`object-position:${photo.position}`}
                  />
                </li>
              ))}
            </ul>
            <figcaption>{teacher.momentsCaption}</figcaption>
          </figure>
        )
      }
    </div>

    <div class="about__content">
      <p class="eyebrow reveal">{teacher.eyebrow}</p>
      <h2 id="sobre-titulo" class="section-title reveal">{teacher.title}</h2>
      {teacher.fullName && (
        <p class="about__fullname reveal">Professora {teacher.fullName}, conhecida como {teacher.name}{teacher.role && `, ${teacher.role.toLowerCase()}`}</p>
      )}
      {teacher.paragraphs.map((text) => <p class="about__text reveal">{text}</p>)}

      {teacher.quote && (
        <blockquote class="about__quote reveal">
          <Icon name="quote" size={28} />
          <p>{teacher.quote}</p>
        </blockquote>
      )}

      <ul class="about__values">
        {
          teacher.values.map((value, i) => (
            <li class="reveal" style={`--delay:${i * 80}ms`}>
              <span class="icon-badge icon-badge--green">
                <Icon name={value.icon} size={22} />
              </span>
              <div>
                <h3>{value.title}</h3>
                <p>{value.text}</p>
              </div>
            </li>
          ))
        }
      </ul>

      {
        credentials.length > 0 && (
          <div class="about__credentials">
            {credentials.map((block) => (
              <div class="credential card">
                <h3>
                  <Icon name={block.icon} size={20} /> {block.title}
                </h3>
                <ul>
                  {block.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        )
      }

      {
        teacher.schools.length > 0 && (
          <div class="about__schools reveal">
            <h3>
              <Icon name="school" size={20} /> {teacher.schoolsTitle}
            </h3>
            <ul>
              {teacher.schools.map((school) => (
                <li>{school}</li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </div>
</Section>

<style>
  .about {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 5rem);
    align-items: center;
  }

  .about__card {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    text-align: center;
    padding: clamp(2rem, 1.5rem + 2vw, 3rem) 1.5rem 3.5rem;
    border-radius: var(--radius-xl);
    background: linear-gradient(160deg, var(--blue-700), var(--blue-900));
    color: var(--white);
    box-shadow: var(--shadow-lg);
  }

  .about__initials {
    display: grid;
    place-items: center;
    width: 112px;
    height: 112px;
    border-radius: 50%;
    background: var(--yellow-500);
    color: var(--blue-900);
    font-family: var(--font-heading);
    font-size: 3.5rem;
    font-weight: 700;
    box-shadow: 0 0 0 8px rgb(255 255 255 / 0.15);
  }

  .about__card-name {
    margin: 1.25rem 0 0;
    font-family: var(--font-heading);
    font-size: var(--fs-600);
    font-weight: 600;
  }

  .about__card-role {
    margin: 0.25rem 0 0;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.85rem;
    color: var(--yellow-300);
  }

  .about__stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    width: 100%;
    margin-top: 1.5rem;
    list-style: none;
  }

  .about__stats li {
    display: grid;
    gap: 0.15rem;
    padding: 0.85rem 0.5rem;
    border-radius: var(--radius);
    background: rgb(255 255 255 / 0.1);
  }

  .about__stats strong {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    line-height: 1.2;
  }

  .about__stats span {
    font-size: 0.85rem;
    opacity: 0.85;
  }

  .about__schools {
    margin-top: 1.5rem;
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }

  .about__schools h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.85rem;
    font-size: 1.05rem;
    color: var(--blue-800);
  }

  .about__schools ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
  }

  .about__schools li {
    padding: 0.35rem 0.8rem;
    border-radius: 999px;
    background: var(--blue-50);
    border: 1px solid var(--blue-100);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--blue-900);
  }

  .about__media {
    position: relative;
    width: min(100%, 460px);
    justify-self: center;
  }

  .about__photo {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    background: var(--blue-100);
  }

  .about__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
  }

  .about__media::before {
    content: '';
    position: absolute;
    inset: -18px 18px 18px -18px;
    border: 2px dashed var(--blue-600);
    border-radius: var(--radius-xl);
    opacity: 0.25;
  }

  .about__moments {
    position: absolute;
    right: -0.75rem;
    bottom: -1.5rem;
    margin: 0;
    padding: 0.75rem 1rem;
    background: var(--white);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
  }

  .about__moments ul {
    display: flex;
    list-style: none;
  }

  .about__moments li + li {
    margin-left: -12px;
  }

  .about__moments img {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--white);
    box-shadow: var(--shadow-sm);
  }

  .about__moments figcaption {
    margin-top: 0.4rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--ink-500);
  }

  .about__fullname {
    margin-top: -0.5rem;
    font-weight: 800;
    color: var(--green-700);
  }

  .about__quote {
    position: relative;
    margin: 1.75rem 0 0;
    padding: 1.25rem 1.5rem 1.25rem 3.75rem;
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }

  .about__quote :global(.icon) {
    position: absolute;
    left: 1.1rem;
    top: 1.2rem;
    color: var(--yellow-500);
  }

  .about__quote p {
    margin: 0;
    font-family: var(--font-heading);
    font-size: var(--fs-500);
    font-style: italic;
    color: var(--blue-900);
  }

  .about__text {
    font-size: var(--fs-500);
    color: var(--color-muted);
  }

  .about__values {
    display: grid;
    gap: 1.25rem;
    margin-top: 2rem;
    list-style: none;
  }

  .about__values li {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .about__values h3 {
    margin-bottom: 0.15rem;
    font-size: 1.1rem;
  }

  .about__values p {
    margin: 0;
    color: var(--color-muted);
  }

  .about__credentials {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 1rem;
    margin-top: 2rem;
  }

  .credential {
    padding: 1.25rem;
  }

  .credential h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.05rem;
    color: var(--blue-800);
  }

  .credential ul {
    padding-left: 1.1rem;
    color: var(--color-muted);
  }

  @media (min-width: 1024px) {
    .about {
      grid-template-columns: 0.85fr 1.15fr;
      align-items: start;
    }

    .about__media {
      position: sticky;
      top: 6.5rem;
      margin-top: 1rem;
    }
  }

  @media (max-width: 767px) {
    .about__photo {
      aspect-ratio: 1 / 1;
    }

    .about__media {
      width: min(100%, 340px);
    }
  }

  @media (max-width: 480px) {
    .about__moments {
      right: 50%;
      transform: translateX(50%);
      width: max-content;
    }

    .about__media::before {
      inset: -10px 10px 10px -10px;
    }
  }
</style>
