---
import Icon from './ui/Icon.astro';
import { hasWhatsapp, whatsappLink } from '../utils/contact';
---

{
  hasWhatsapp && (
    <a
      href={whatsappLink()}
      class="wa-float"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Conversar com a Professora Meire pelo WhatsApp (abre em nova aba)"
    >
      <Icon name="whatsapp" size={30} />
    </a>
  )
}

<style>
  .wa-float {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 90;
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: #1f9d55;
    color: var(--white);
    box-shadow: 0 10px 28px rgb(31 157 85 / 0.4);
    transition:
      transform 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }

  .wa-float:hover {
    transform: translateY(-3px) scale(1.04);
    box-shadow: 0 14px 34px rgb(31 157 85 / 0.5);
  }

  /* No celular, a barra fixa (StickyMobileCTA) já tem o WhatsApp */
  @media (max-width: 767px) {
    .wa-float {
      display: none;
    }
  }

  @media (min-width: 1024px) {
    .wa-float {
      right: 1.75rem;
      bottom: 1.75rem;
    }
  }
</style>
