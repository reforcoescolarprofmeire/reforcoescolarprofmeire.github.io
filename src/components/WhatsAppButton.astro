---
import Icon from './ui/Icon.astro';
import { hasWhatsapp, whatsappLink } from '../utils/contact';
---

{
  hasWhatsapp && (
    <a
      href={whatsappLink()}
      class="wa-float"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Conversar com a Professora Meire pelo WhatsApp (abre em nova aba)"
    >
      <Icon name="whatsapp" size={30} />
    </a>
  )
}

<style>
  /* Verde do WhatsApp, escurecido para o ícone branco passar no contraste */
  .wa-float {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 90;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #1f7a45;
    color: #fff;
    box-shadow: 0 2px 8px rgb(35 38 46 / 0.25);
  }

  .wa-float:hover {
    background: #17633a;
  }
</style>
