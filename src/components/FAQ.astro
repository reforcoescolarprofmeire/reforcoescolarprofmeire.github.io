---
import Section from './ui/Section.astro';
import SectionHeader from './ui/SectionHeader.astro';
import Icon from './ui/Icon.astro';
import { faqSection as data } from '../data/faq';
---

<Section id="duvidas" tone="blue">
  <SectionHeader id="duvidas-titulo" eyebrow={data.eyebrow} title={data.title} intro={data.intro} />

  <div class="faq">
    {
      data.items.map((item, i) => (
        <details class="faq__item reveal" name="faq" open={i === 0}>
          <summary>
            <h3 class="faq__question">{item.question}</h3>
            <span class="faq__icon" aria-hidden="true">
              <Icon name="chevron-down" size={20} />
            </span>
          </summary>
          <div class="faq__answer">
            <p>{item.answer}</p>
          </div>
        </details>
      ))
    }
  </div>
</Section>

<style>
  .faq {
    display: grid;
    gap: 0.75rem;
    max-width: 820px;
    margin-inline: auto;
  }

  .faq__item {
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    transition:
      border-color 0.25s var(--ease),
      box-shadow 0.25s var(--ease);
  }

  .faq__item[open] {
    border-color: var(--blue-100);
    box-shadow: var(--shadow);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 1.35rem;
    cursor: pointer;
    list-style: none;
    border-radius: var(--radius);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .faq__question {
    margin: 0;
    font-family: var(--font-body);
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .faq__icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--blue-50);
    color: var(--blue-700);
    transition: transform 0.3s var(--ease);
  }

  .faq__item[open] .faq__icon {
    transform: rotate(180deg);
    background: var(--color-primary);
    color: var(--white);
  }

  .faq__answer {
    padding: 0 1.35rem 1.25rem;
    color: var(--color-muted);
  }

  .faq__answer p {
    margin: 0;
  }

  .faq__item[open] .faq__answer {
    animation: faq-open 0.35s var(--ease);
  }

  @keyframes faq-open {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }
</style>
