---
import Section from './ui/Section.astro';
import SectionHeader from './ui/SectionHeader.astro';
import Icon from './ui/Icon.astro';
import { howItWorks as data } from '../data/howItWorks';
---

<Section id="como-funciona" tone="white">
  <SectionHeader id="como-funciona-titulo" eyebrow={data.eyebrow} title={data.title} intro={data.intro} />

  <ol class="timeline">
    {
      data.steps.map((step, i) => (
        <li class="timeline__step reveal" style={`--delay:${i * 80}ms`}>
          <span class="timeline__number" aria-hidden="true">{i + 1}</span>
          <div class="timeline__body">
            <h3>
              <span class="sr-only">Passo {i + 1}: </span>
              {step.title}
            </h3>
            <p>{step.text}</p>
            <p class="timeline__delivers">
              <Icon name="check-circle" size={18} />
              <span>
                <span class="sr-only">A família recebe: </span>
                {step.delivers}
              </span>
            </p>
          </div>
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .timeline {
    display: grid;
    gap: 0;
    list-style: none;
    max-width: 720px;
    margin-inline: auto;
  }

  .timeline__step {
    position: relative;
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 1rem;
    padding-bottom: 1.75rem;
  }

  /* Linha vertical ligando os passos */
  .timeline__step:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 25px;
    top: 52px;
    bottom: 0;
    width: 2px;
    background: linear-gradient(var(--blue-100), var(--green-100));
  }

  .timeline__number {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--blue-700);
    color: var(--white);
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    box-shadow: 0 0 0 6px var(--blue-50);
  }

  .timeline__step:last-child .timeline__number {
    background: var(--green-600);
    box-shadow: 0 0 0 6px var(--green-50);
  }

  .timeline__body h3 {
    margin: 0.65rem 0 0.3rem;
  }

  .timeline__body p {
    margin: 0;
    color: var(--color-muted);
  }

  .timeline__body .timeline__delivers {
    display: inline-flex;
    gap: 0.5rem;
    align-items: flex-start;
    margin-top: 0.75rem;
    padding: 0.5rem 0.85rem;
    border-radius: 12px;
    background: var(--green-50);
    color: var(--green-700);
    font-weight: 700;
    font-size: 0.93rem;
  }

  .timeline__delivers :global(.icon) {
    flex-shrink: 0;
    margin-top: 2px;
  }

  /* Computador: linha do tempo horizontal */
  @media (min-width: 1024px) {
    .timeline {
      grid-template-columns: repeat(5, 1fr);
      gap: 1.25rem;
      max-width: none;
    }

    .timeline__step {
      grid-template-columns: 1fr;
      padding-bottom: 0;
      align-content: start;
    }

    .timeline__step:not(:last-child)::before {
      left: 64px;
      right: -1.25rem;
      top: 25px;
      bottom: auto;
      width: auto;
      height: 2px;
      background: linear-gradient(90deg, var(--blue-100), var(--green-100));
    }
  }
</style>
