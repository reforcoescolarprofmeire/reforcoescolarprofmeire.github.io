---
import Section from './ui/Section.astro';
import SectionHeader from './ui/SectionHeader.astro';
import Anotacao from './ui/Anotacao.astro';
import { howItWorks as data } from '../data/howItWorks';
---

<Section id="como-funciona">
  <SectionHeader id="como-funciona-titulo" title={data.title} intro={data.intro} />

  <ol class="steps">
    {
      data.steps.map((step, i) => (
        <li class:list={['step', { 'com-nota': i === 0 }]}>
          <span class="step__number" aria-hidden="true">
            {i + 1}
          </span>
          <div>
            <h3>
              <span class="sr-only">Etapa {i + 1}: </span>
              {step.title}
            </h3>
            <p>{step.text}</p>
          </div>
          {i === 0 && <Anotacao top="0.3rem">a família participa desde o primeiro passo</Anotacao>}
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .steps {
    display: grid;
    list-style: none;
    max-width: 48rem;
  }

  .step {
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    column-gap: 1rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--pauta);
  }

  .step:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .step__number {
    font-size: var(--t-3);
    font-weight: 700;
    line-height: 1;
    color: var(--caneta);
    font-variant-numeric: tabular-nums;
  }

  .step h3 {
    margin-bottom: 0.3rem;
  }

  .step p {
    margin: 0;
    color: var(--grafite-suave);
  }

  .step :global(.anotacao) {
    grid-column: 2;
    margin-bottom: 0;
  }

  @media (min-width: 960px) {
    .steps {
      max-width: none;
    }

    .step :global(.anotacao) {
      grid-column: auto;
    }
  }
</style>
