---
import { Image } from 'astro:assets';
import Section from './ui/Section.astro';
import { methodologySection as data } from '../data/methodology';
import methodImage from '../assets/images/galeria/leitura-acompanhada.jpg';
---

<Section id="metodologia">
  <div class="method">
    <div>
      <h2 id="metodologia-titulo" class="section-title">{data.title}</h2>
      {data.paragraphs.map((text) => <p>{text}</p>)}

      <ul class="lista-traco method__list">
        {data.items.map((item) => <li>{item.title}</li>)}
      </ul>
    </div>

    <figure class="method__media">
      <Image
        src={methodImage}
        alt="Professora acompanhando a leitura de um aluno, com livros e lápis sobre a mesa"
        widths={[480, 720, 960]}
        sizes="(min-width: 1100px) 360px, (min-width: 640px) 60vw, 92vw"
        class="method__img"
      />
    </figure>
  </div>
</Section>

<style>
  .method {
    display: grid;
    gap: 2rem;
    align-items: start;
  }

  .method__list {
    margin-top: 1.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
  }

  .method__media {
    margin: 0;
    max-width: 480px;
  }

  .method__img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  @media (min-width: 1100px) {
    .method {
      grid-template-columns: 1fr 360px;
      gap: 3rem;
    }
  }
</style>
