---
import Section from './ui/Section.astro';
import SectionHeader from './ui/SectionHeader.astro';
import Icon from './ui/Icon.astro';
import { subjectsSection as data } from '../data/subjects';
---

{
  data.items.length > 0 && (
    <Section id="areas" tone="green">
      <SectionHeader id="areas-titulo" title={data.title} intro={data.intro} />

      <ul class="subjects">
        {data.items.map((item, i) => (
          <li class="subject card card--hover reveal" style={`--delay:${i * 50}ms`}>
            <span class="icon-badge icon-badge--green">
              <Icon name={item.icon} size={22} />
            </span>
            <span class="subject__title">{item.title}</span>
          </li>
        ))}
      </ul>
    </Section>
  )
}

<style>
  .subjects {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    list-style: none;
    max-width: 980px;
    margin-inline: auto;
  }

  .subject {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex: 1 1 260px;
    max-width: 310px;
    padding: 1rem 1.25rem 1rem 1rem;
  }

  .subject__title {
    font-weight: 800;
    font-size: 1.02rem;
    line-height: 1.3;
  }

  @media (max-width: 600px) {
    .subject {
      max-width: none;
    }
  }
</style>
