---
import Section from './ui/Section.astro';
import SectionHeader from './ui/SectionHeader.astro';
import Icon from './ui/Icon.astro';
import ContactForm from './ContactForm.astro';
import { contactSection as data } from '../data/cta';
import { getContactChannels } from '../utils/contact';

const channels = getContactChannels();
---

<Section id="contato">
  <SectionHeader id="contato-titulo" title={data.title} intro={data.intro} />

  <div class="contact">
    <aside class="contact__info" aria-label="Canais de atendimento">
      {
        channels.length > 0 ? (
          <ul class="contact__channels">
            {channels.map((channel) => (
              <li>
                <Icon name={channel.icon} size={22} />
                <div>
                  <span class="contact__label">{channel.label}</span>
                  {channel.href ? (
                    <a
                      href={channel.href}
                      class="contact__value"
                      target={channel.external ? '_blank' : undefined}
                      rel={channel.external ? 'noopener noreferrer' : undefined}
                    >
                      {channel.value}
                    </a>
                  ) : (
                    <span class="contact__value">{channel.value}</span>
                  )}
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <div class="contact__empty">
            <h3>{data.emptyTitle}</h3>
            <p>{data.emptyText}</p>
          </div>
        )
      }

      <div class="contact__promise">
        <p>Cada família é recebida com atenção. Conte sua necessidade sem compromisso.</p>
      </div>
    </aside>

    <ContactForm />
  </div>
</Section>

<style>
  .contact {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  .contact__channels {
    display: grid;
    list-style: none;
  }

  .contact__channels li {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--pauta);
  }

  .contact__channels li:first-child {
    padding-top: 0;
  }

  .contact__channels li > div {
    min-width: 0;
  }

  .contact__channels :global(.icon) {
    flex-shrink: 0;
    color: var(--caneta);
  }

  .contact__label {
    display: block;
    font-size: var(--t--1);
    color: var(--grafite-suave);
  }

  .contact__value {
    display: block;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  span.contact__value {
    color: var(--grafite);
  }

  .contact__empty h3 {
    margin: 0 0 0.4rem;
    font-size: var(--t-0);
  }

  .contact__empty p {
    margin: 0;
    color: var(--grafite-suave);
  }

  .contact__promise {
    margin-top: 1.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--pauta);
  }

  .contact__promise p {
    margin: 0;
  }

  @media (min-width: 1100px) {
    .contact {
      grid-template-columns: 16rem 1fr;
      gap: 3rem;
    }
  }
</style>
