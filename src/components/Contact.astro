---
import Section from './ui/Section.astro';
import SectionHeader from './ui/SectionHeader.astro';
import Icon from './ui/Icon.astro';
import ContactForm from './ContactForm.astro';
import { contactSection as data } from '../data/cta';
import { getContactChannels } from '../utils/contact';

const channels = getContactChannels();
---

<Section id="contato" tone="blue">
  <SectionHeader id="contato-titulo" eyebrow={data.eyebrow} title={data.title} intro={data.intro} />

  <div class="contact">
    <aside class="contact__info reveal" aria-label="Canais de atendimento">
      {
        channels.length > 0 ? (
          <ul class="contact__channels">
            {channels.map((channel) => (
              <li>
                <span class="icon-badge">
                  <Icon name={channel.icon} size={22} />
                </span>
                <div>
                  <span class="contact__label">{channel.label}</span>
                  {channel.href ? (
                    <a
                      href={channel.href}
                      class="contact__value"
                      target={channel.external ? '_blank' : undefined}
                      rel={channel.external ? 'noopener noreferrer' : undefined}
                    >
                      {channel.value}
                    </a>
                  ) : (
                    <span class="contact__value">{channel.value}</span>
                  )}
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <div class="contact__empty">
            <span class="icon-badge icon-badge--yellow">
              <Icon name="clock" size={22} />
            </span>
            <h3>{data.emptyTitle}</h3>
            <p>{data.emptyText}</p>
          </div>
        )
      }

      <div class="contact__promise">
        <Icon name="heart" size={20} />
        <p>Cada família é recebida com atenção. Conte sua necessidade sem compromisso.</p>
      </div>
    </aside>

    <ContactForm />
  </div>
</Section>

<style>
  .contact {
    display: grid;
    gap: 1.5rem;
    align-items: start;
  }

  .contact__info {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.5rem, 1.2rem + 1.5vw, 2.25rem);
    border-radius: var(--radius-lg);
    background: var(--blue-900);
    color: var(--white);
    box-shadow: var(--shadow-lg);
  }

  .contact__channels {
    display: grid;
    gap: 1.25rem;
    list-style: none;
  }

  .contact__channels li {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }

  .contact__channels li > div {
    min-width: 0;
  }

  .contact__info .icon-badge {
    background: rgb(255 255 255 / 0.12);
    color: var(--yellow-300);
  }

  .contact__label {
    display: block;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(255 255 255 / 0.7);
  }

  .contact__value {
    display: block;
    font-weight: 700;
    color: var(--white);
    overflow-wrap: anywhere;
  }

  a.contact__value:hover {
    color: var(--yellow-300);
  }

  .contact__empty h3 {
    margin: 1rem 0 0.4rem;
    color: var(--white);
  }

  .contact__empty p {
    margin: 0;
    color: rgb(255 255 255 / 0.8);
  }

  .contact__promise {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.14);
    color: var(--yellow-300);
  }

  .contact__promise :global(.icon) {
    flex-shrink: 0;
    margin-top: 3px;
  }

  .contact__promise p {
    margin: 0;
    color: rgb(255 255 255 / 0.85);
    font-size: 0.95rem;
  }

  @media (min-width: 1024px) {
    .contact {
      grid-template-columns: 0.8fr 1.2fr;
      gap: 2rem;
    }

    .contact__info {
      position: sticky;
      top: calc(var(--header-h) + 1.5rem);
    }
  }
</style>
