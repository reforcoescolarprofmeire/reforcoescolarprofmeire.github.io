---
import Section from './ui/Section.astro';
import SectionHeader from './ui/SectionHeader.astro';
import Icon from './ui/Icon.astro';
import { forWhomSection as data } from '../data/forWhom';
import { hasValue } from '../utils/contact';

// Disciplinas por etapa quando houver dados; senão, a lista geral.
const stages = data.stages.filter((stage) => stage.subjects.length > 0);
---

<Section id="para-quem" tone="green">
  <SectionHeader id="para-quem-titulo" eyebrow={data.eyebrow} title={data.title} intro={data.intro} />

  {
    hasValue(data.grades) && (
      <p class="forwhom__grades reveal">
        <Icon name="graduation-cap" size={20} /> {data.grades}
      </p>
    )
  }

  <div class="forwhom">
    <div class="forwhom__box reveal">
      <h3>{data.subjectsTitle}</h3>
      {
        stages.length > 0 ? (
          <div class="forwhom__stages">
            {stages.map((stage) => (
              <div>
                <h4>{stage.name}</h4>
                <ul class="forwhom__tags">
                  {stage.subjects.map((subject) => (
                    <li>{subject}</li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        ) : (
          <ul class="forwhom__tags">
            {data.subjects.map((subject) => (
              <li>{subject}</li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="forwhom__box reveal" style="--delay:80ms">
      <h3>{data.skillsTitle}</h3>
      <ul class="forwhom__skills">
        {
          data.skills.map((skill) => (
            <li>
              <span class="icon-badge icon-badge--green">
                <Icon name={skill.icon} size={20} />
              </span>
              {skill.text}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  {
    hasValue(data.inclusion) && (
      <p class="forwhom__inclusion reveal">
        <Icon name="heart" size={20} />
        {data.inclusion}
      </p>
    )
  }
</Section>

<style>
  .forwhom__grades {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: -1.5rem auto 2rem;
    font-weight: 800;
    color: var(--green-700);
    text-align: center;
  }

  .forwhom {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 1.25rem;
    max-width: 1000px;
    margin-inline: auto;
  }

  .forwhom__box {
    padding: 1.75rem;
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }

  .forwhom__box h3 {
    margin-bottom: 1.1rem;
    font-size: var(--fs-500);
  }

  .forwhom__box h4 {
    margin: 0 0 0.5rem;
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--green-700);
  }

  .forwhom__stages {
    display: grid;
    gap: 1.1rem;
  }

  .forwhom__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
  }

  .forwhom__tags li {
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    background: var(--blue-50);
    border: 1px solid var(--blue-100);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--blue-900);
  }

  .forwhom__skills {
    display: grid;
    gap: 0.85rem;
    list-style: none;
  }

  .forwhom__skills li {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-weight: 700;
  }

  .forwhom__skills .icon-badge {
    width: 42px;
    height: 42px;
    border-radius: 12px;
  }

  .forwhom__inclusion {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    max-width: 760px;
    margin: 2rem auto 0;
    font-weight: 600;
    color: var(--ink-700);
  }

  .forwhom__inclusion :global(.icon) {
    flex-shrink: 0;
    margin-top: 3px;
    color: var(--green-700);
  }
</style>
