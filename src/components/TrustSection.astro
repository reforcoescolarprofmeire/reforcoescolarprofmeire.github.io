---
import Section from './ui/Section.astro';
import SectionHeader from './ui/SectionHeader.astro';
import Icon from './ui/Icon.astro';
import { trustSection as data } from '../data/trust';
---

<Section id="acompanhamento" tone="blue">
  <SectionHeader id="acompanhamento-titulo" eyebrow={data.eyebrow} title={data.title} intro={data.intro} />

  <ul class="trust">
    {
      data.items.map((item, i) => (
        <li class="trust__item card reveal" style={`--delay:${(i % 4) * 70}ms`}>
          <span class="icon-badge">
            <Icon name={item.icon} size={22} />
          </span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </div>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .trust {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 1rem;
    list-style: none;
  }

  .trust__item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    padding: 1.35rem;
  }

  .trust__item h3 {
    font-size: 1.1rem;
    margin-bottom: 0.25rem;
  }

  .trust__item p {
    margin: 0;
    font-size: 0.975rem;
    color: var(--color-muted);
  }

  @media (min-width: 1100px) {
    .trust {
      grid-template-columns: repeat(4, 1fr);
    }

    /* 7 itens: o último ocupa o espaço restante da linha */
    .trust__item:last-child:nth-child(4n + 3) {
      grid-column: span 2;
    }
  }
</style>
