---
import Section from './ui/Section.astro';
import SectionHeader from './ui/SectionHeader.astro';
import { trustSection as data } from '../data/trust';
---

<Section id="acompanhamento">
  <SectionHeader id="acompanhamento-titulo" title={data.title} intro={data.intro} />

  <dl class="definicoes definicoes--2">
    {
      data.items.map((item) => (
        <div>
          <dt>{item.title}</dt>
          <dd>{item.text}</dd>
        </div>
      ))
    }
  </dl>
</Section>
