---
import Section from './ui/Section.astro';
import SectionHeader from './ui/SectionHeader.astro';
import { testimonials, testimonialsSection as data } from '../data/testimonials';

// Ignora itens incompletos para nunca exibir campos vazios.
const items = testimonials.filter((t) => t.name.trim() && t.text.trim());
---

{
  items.length > 0 && (
    <Section id="depoimentos">
      <SectionHeader id="depoimentos-titulo" title={data.title} />

      <ul class="bilhetes">
        {items.map((item) => {
          const rating = item.rating ? Math.max(1, Math.min(5, Math.round(item.rating))) : 0;
          return (
            <li class="bilhete">
              <figure>
                <blockquote>
                  <p>{item.text}</p>
                </blockquote>
                <figcaption>
                  <strong>{item.name}</strong>
                  {item.relationship && <span>{item.relationship}</span>}
                  {rating > 0 && <span class="bilhete__nota">Avaliação: {rating} de 5</span>}
                </figcaption>
              </figure>
            </li>
          );
        })}
      </ul>
    </Section>
  )
}

<style>
  /* Cada depoimento é um bilhete dos pais, preso à folha */
  .bilhetes {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: 1.5rem;
    list-style: none;
  }

  .bilhete figure {
    margin: 0;
    padding: 1.25rem 1.25rem 1rem;
    border: 1px solid var(--pauta);
    border-left: 3px solid var(--caneta);
    background: var(--papel);
  }

  .bilhete:nth-child(odd) figure {
    transform: rotate(-0.6deg);
  }

  .bilhete:nth-child(even) figure {
    transform: rotate(0.5deg);
  }

  .bilhete blockquote {
    margin: 0 0 1rem;
  }

  .bilhete blockquote p {
    margin: 0;
  }

  .bilhete figcaption {
    display: grid;
    font-size: 0.95rem;
  }

  .bilhete figcaption span {
    color: var(--grafite-suave);
  }
</style>
