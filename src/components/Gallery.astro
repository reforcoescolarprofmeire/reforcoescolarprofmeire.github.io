---
import { Image, getImage } from 'astro:assets';
import Section from './ui/Section.astro';
import SectionHeader from './ui/SectionHeader.astro';
import Icon from './ui/Icon.astro';
import { gallery, gallerySection as data, galleryHasIllustrativeImages } from '../data/gallery';

// Versão ampliada (usada no lightbox) gerada no build, sem ultrapassar o tamanho original.
const items = await Promise.all(
  gallery.map(async (item) => {
    const large = await getImage({ src: item.src, width: Math.min(item.src.width, 1600), format: 'webp' });
    return { ...item, large: large.src };
  }),
);
---

{
  items.length > 0 && (
    <Section id="galeria">
      <SectionHeader id="galeria-titulo" title={data.title} intro={data.intro} />

      <ul class="gallery" data-gallery>
        {items.map((item, i) => (
          <li class:list={['gallery__item', { 'gallery__item--wide': item.wide }]}>
            <button
              type="button"
              class="gallery__button"
              data-index={i}
              data-large={item.large}
              data-alt={item.alt}
              data-caption={item.caption ?? ''}
              aria-label={`Ampliar foto: ${item.alt}`}
            >
              <Image
                src={item.src}
                alt={item.alt}
                widths={[360, 560, 800]}
                sizes={item.wide ? '(min-width: 1024px) 780px, (min-width: 640px) 46vw, 92vw' : '(min-width: 1024px) 390px, (min-width: 640px) 46vw, 92vw'}
                class="gallery__img"
              />
              {item.caption && <span class="gallery__caption">{item.caption}</span>}
            </button>
          </li>
        ))}
      </ul>

      {galleryHasIllustrativeImages && (
        <p class="gallery__note">
          Algumas imagens são ilustrativas e representam o dia a dia do reforço.
        </p>
      )}

      <dialog class="lightbox" aria-label="Visualização da foto" data-lightbox>
        <div class="lightbox__inner">
          <figure class="lightbox__figure">
            <img class="lightbox__img" src="data:image/gif;base64,R0lGODlhAQABAAAAACw=" alt="" data-lightbox-img />
            <figcaption class="lightbox__caption" data-lightbox-caption aria-live="polite" />
          </figure>
          <button type="button" class="lightbox__btn lightbox__close" aria-label="Fechar" data-lightbox-close>
            <Icon name="x" size={24} />
          </button>
          <button type="button" class="lightbox__btn lightbox__prev" aria-label="Foto anterior" data-lightbox-prev>
            <Icon name="chevron-left" size={26} />
          </button>
          <button type="button" class="lightbox__btn lightbox__next" aria-label="Próxima foto" data-lightbox-next>
            <Icon name="chevron-right" size={26} />
          </button>
        </div>
      </dialog>
    </Section>
  )
}

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery] .gallery__button'));

  if (dialog && buttons.length) {
    const img = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lightbox-caption]')!;
    let current = 0;
    let opener: HTMLButtonElement | null = null;

    const show = (index: number) => {
      current = (index + buttons.length) % buttons.length;
      const { large = '', alt = '', caption: text = '' } = buttons[current].dataset;
      img.src = large;
      img.alt = alt;
      caption.textContent = `${text ? `${text} · ` : ''}${current + 1} de ${buttons.length}`;
    };

    buttons.forEach((button, index) =>
      button.addEventListener('click', () => {
        opener = button;
        show(index);
        dialog.showModal();
        document.body.classList.add('no-scroll');
      }),
    );

    dialog.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(current + 1));
    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(current - 1);
      if (event.key === 'ArrowRight') show(current + 1);
    });

    // Clique fora da imagem fecha
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog || (event.target as HTMLElement).classList.contains('lightbox__inner')) dialog.close();
    });

    dialog.addEventListener('close', () => {
      document.body.classList.remove('no-scroll');
      opener?.focus();
    });
  }
</script>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    grid-auto-flow: dense;
    gap: 1.5rem 1rem;
    list-style: none;
  }

  .gallery__button {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: zoom-in;
  }

  .gallery__img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    background: var(--pauta);
  }

  .gallery__caption {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.95rem;
    color: var(--grafite-suave);
  }

  .gallery__button:hover .gallery__caption {
    color: var(--caneta);
    text-decoration: underline;
  }

  .gallery__note {
    margin: 1.5rem 0 0;
    font-size: var(--t--1);
    color: var(--grafite-suave);
  }

  @media (min-width: 1024px) {
    .gallery {
      grid-template-columns: repeat(3, 1fr);
    }

    .gallery__item--wide {
      grid-column: span 2;
    }

    .gallery__item--wide .gallery__img {
      aspect-ratio: 16 / 9;
    }

    .gallery__item:not(.gallery__item--wide) .gallery__img {
      aspect-ratio: 4 / 4.5;
    }
  }

  /* Lightbox */
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: #fafbfd;
  }

  .lightbox::backdrop {
    background: rgb(20 26 36 / 0.94);
  }

  .lightbox__inner {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: 4.5rem 1rem 2rem;
  }

  .lightbox__figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    max-width: min(1200px, 100%);
  }

  .lightbox__img {
    max-width: 100%;
    max-height: calc(100dvh - 10rem);
    width: auto;
    height: auto;
  }

  .lightbox__caption {
    text-align: center;
    color: #e8ecf3;
  }

  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid rgb(232 236 243 / 0.5);
    border-radius: var(--raio-botao);
    background: transparent;
    color: #fafbfd;
  }

  .lightbox__btn:hover {
    background: rgb(232 236 243 / 0.15);
  }

  .lightbox__btn:focus-visible {
    outline-color: #fafbfd;
  }

  .lightbox__close {
    top: 1rem;
    right: 1rem;
  }

  .lightbox__prev,
  .lightbox__next {
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox__prev {
    left: 1rem;
  }

  .lightbox__next {
    right: 1rem;
  }

  @media (max-width: 640px) {
    .lightbox__prev,
    .lightbox__next {
      top: auto;
      bottom: 1rem;
      transform: none;
    }

    .lightbox__inner {
      padding-bottom: 5rem;
    }

    .lightbox__img {
      max-height: calc(100dvh - 12rem);
    }
  }
</style>
