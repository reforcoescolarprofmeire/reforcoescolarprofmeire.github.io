---
import { Image, getImage } from 'astro:assets';
import Section from './ui/Section.astro';
import SectionHeader from './ui/SectionHeader.astro';
import Icon from './ui/Icon.astro';
import { gallery, gallerySection as data, galleryHasIllustrativeImages } from '../data/gallery';

// Versão ampliada (usada no lightbox) gerada no build, sem ultrapassar o tamanho original.
const items = await Promise.all(
  gallery.map(async (item) => {
    const large = await getImage({ src: item.src, width: Math.min(item.src.width, 1600), format: 'webp' });
    return { ...item, large: large.src };
  }),
);
---

{
  items.length > 0 && (
    <Section id="galeria" tone="white">
      <SectionHeader id="galeria-titulo" eyebrow={data.eyebrow} title={data.title} intro={data.intro} />

      <ul class="gallery" data-gallery>
        {items.map((item, i) => (
          <li class:list={['gallery__item reveal', { 'gallery__item--wide': item.wide }]} style={`--delay:${(i % 3) * 80}ms`}>
            <button
              type="button"
              class="gallery__button"
              data-index={i}
              data-large={item.large}
              data-alt={item.alt}
              data-caption={item.caption ?? ''}
              aria-label={`Ampliar foto: ${item.alt}`}
            >
              <Image
                src={item.src}
                alt={item.alt}
                widths={[360, 560, 800]}
                sizes={item.wide ? '(min-width: 1024px) 780px, (min-width: 640px) 46vw, 92vw' : '(min-width: 1024px) 390px, (min-width: 640px) 46vw, 92vw'}
                class="gallery__img"
              />
              {item.caption && <span class="gallery__caption">{item.caption}</span>}
              <span class="gallery__zoom" aria-hidden="true">
                <Icon name="zoom-in" size={20} />
              </span>
            </button>
          </li>
        ))}
      </ul>

      {galleryHasIllustrativeImages && (
        <p class="gallery__note">
          <Icon name="info" size={16} /> Algumas imagens são ilustrativas e representam o dia a dia do reforço.
        </p>
      )}

      <dialog class="lightbox" aria-label="Visualização da foto" data-lightbox>
        <div class="lightbox__inner">
          <figure class="lightbox__figure">
            <img class="lightbox__img" src="data:image/gif;base64,R0lGODlhAQABAAAAACw=" alt="" data-lightbox-img />
            <figcaption class="lightbox__caption" data-lightbox-caption aria-live="polite" />
          </figure>
          <button type="button" class="lightbox__btn lightbox__close" aria-label="Fechar" data-lightbox-close>
            <Icon name="x" size={24} />
          </button>
          <button type="button" class="lightbox__btn lightbox__prev" aria-label="Foto anterior" data-lightbox-prev>
            <Icon name="chevron-left" size={26} />
          </button>
          <button type="button" class="lightbox__btn lightbox__next" aria-label="Próxima foto" data-lightbox-next>
            <Icon name="chevron-right" size={26} />
          </button>
        </div>
      </dialog>
    </Section>
  )
}

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery] .gallery__button'));

  if (dialog && buttons.length) {
    const img = dialog.querySelector<HTMLImageElement>('[data-lightbox-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lightbox-caption]')!;
    let current = 0;
    let opener: HTMLButtonElement | null = null;

    const show = (index: number) => {
      current = (index + buttons.length) % buttons.length;
      const { large = '', alt = '', caption: text = '' } = buttons[current].dataset;
      img.src = large;
      img.alt = alt;
      caption.textContent = `${text ? `${text} · ` : ''}${current + 1} de ${buttons.length}`;
    };

    buttons.forEach((button, index) =>
      button.addEventListener('click', () => {
        opener = button;
        show(index);
        dialog.showModal();
        document.body.classList.add('no-scroll');
      }),
    );

    dialog.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(current + 1));
    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') show(current - 1);
      if (event.key === 'ArrowRight') show(current + 1);
    });

    // Clique fora da imagem fecha
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog || (event.target as HTMLElement).classList.contains('lightbox__inner')) dialog.close();
    });

    dialog.addEventListener('close', () => {
      document.body.classList.remove('no-scroll');
      opener?.focus();
    });
  }
</script>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    grid-auto-flow: dense;
    gap: 1rem;
    list-style: none;
  }

  .gallery__button {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--blue-100);
    aspect-ratio: 4 / 3;
    cursor: zoom-in;
  }

  .gallery__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  .gallery__button::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, rgb(22 35 58 / 0.65));
    pointer-events: none;
  }

  .gallery__caption {
    position: absolute;
    z-index: 1;
    left: 1rem;
    right: 3.5rem;
    bottom: 0.9rem;
    color: var(--white);
    font-weight: 800;
    font-size: 0.975rem;
    text-align: left;
    text-shadow: 0 1px 4px rgb(0 0 0 / 0.35);
  }

  .gallery__zoom {
    position: absolute;
    z-index: 1;
    right: 0.8rem;
    bottom: 0.8rem;
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.92);
    color: var(--blue-800);
    transform: scale(0.85);
    opacity: 0.85;
    transition:
      transform 0.3s var(--ease),
      opacity 0.3s var(--ease);
  }

  .gallery__button:hover .gallery__img,
  .gallery__button:focus-visible .gallery__img {
    transform: scale(1.05);
  }

  .gallery__button:hover .gallery__zoom,
  .gallery__button:focus-visible .gallery__zoom {
    transform: scale(1);
    opacity: 1;
  }

  .gallery__note {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    margin: 1.5rem 0 0;
    font-size: 0.85rem;
    color: var(--ink-500);
    text-align: center;
  }

  .gallery__note :global(.icon) {
    flex-shrink: 0;
  }

  /* Celular: carrossel horizontal (deslizar), em vez de 6 fotos empilhadas */
  @media (max-width: 639px) {
    .gallery {
      display: flex;
      gap: 0.75rem;
      margin-inline: calc(var(--gutter) * -1);
      padding: 0 var(--gutter) 0.5rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }

    .gallery::-webkit-scrollbar {
      display: none;
    }

    .gallery__item {
      flex: 0 0 82%;
      scroll-snap-align: start;
    }
  }

  @media (min-width: 1024px) {
    .gallery {
      grid-template-columns: repeat(3, 1fr);
    }

    .gallery__item--wide {
      grid-column: span 2;
    }

    .gallery__item--wide .gallery__button {
      aspect-ratio: auto;
    }

    .gallery__item:not(.gallery__item--wide) .gallery__button {
      aspect-ratio: 4 / 4.2;
    }
  }

  /* Lightbox */
  .lightbox {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--white);
  }

  .lightbox::backdrop {
    background: rgb(14 22 38 / 0.9);
  }

  .lightbox[open] {
    animation: fade-in 0.25s var(--ease);
  }

  .lightbox__inner {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: 4.5rem 1rem 2rem;
  }

  .lightbox__figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
    max-width: min(1200px, 100%);
  }

  .lightbox__img {
    max-width: 100%;
    max-height: calc(100dvh - 10rem);
    width: auto;
    height: auto;
    border-radius: var(--radius);
    box-shadow: 0 20px 60px rgb(0 0 0 / 0.4);
    background: var(--ink-700);
  }

  .lightbox__caption {
    font-weight: 700;
    text-align: center;
    color: rgb(255 255 255 / 0.9);
  }

  .lightbox__btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.14);
    color: var(--white);
    transition: background-color 0.2s var(--ease);
  }

  .lightbox__btn:hover {
    background: rgb(255 255 255 / 0.28);
  }

  .lightbox__close {
    top: 1rem;
    right: 1rem;
  }

  .lightbox__prev,
  .lightbox__next {
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox__prev {
    left: 1rem;
  }

  .lightbox__next {
    right: 1rem;
  }

  @media (max-width: 640px) {
    .lightbox__prev,
    .lightbox__next {
      top: auto;
      bottom: 1rem;
      transform: none;
    }

    .lightbox__inner {
      padding-bottom: 5rem;
    }

    .lightbox__img {
      max-height: calc(100dvh - 12rem);
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
</style>
