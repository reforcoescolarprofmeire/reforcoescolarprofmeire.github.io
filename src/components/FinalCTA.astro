---
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';
import { finalCta as data } from '../data/cta';
import { primaryContact, hasWhatsapp } from '../utils/contact';
---

<section class="final-cta" aria-labelledby="cta-final-titulo">
  <div class="container">
    <div class="final-cta__box reveal">
      <span class="final-cta__star" aria-hidden="true">
        <Icon name="star" size={34} />
      </span>
      <h2 id="cta-final-titulo">{data.title}</h2>
      <p>{data.text}</p>
      <div class="final-cta__actions">
        <Button href={primaryContact.href} external={primaryContact.external} variant="light" size="lg" icon="arrow-right">
          {data.primaryLabel}
        </Button>
        {
          hasWhatsapp && (
            <Button href="#contato" variant="ghost" size="lg" class="final-cta__secondary">
              {data.secondaryLabel}
            </Button>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta {
    padding-block: clamp(3rem, 2rem + 4vw, 6rem);
    background: var(--white);
  }

  .final-cta__box {
    position: relative;
    overflow: hidden;
    padding: clamp(2.5rem, 2rem + 4vw, 5rem) clamp(1.5rem, 1rem + 4vw, 5rem);
    border-radius: var(--radius-xl);
    background: linear-gradient(135deg, var(--blue-800), var(--blue-700) 60%, #2c7a9e);
    color: var(--white);
    text-align: center;
    box-shadow: var(--shadow-lg);
  }

  .final-cta__box::before,
  .final-cta__box::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .final-cta__box::before {
    width: 340px;
    height: 340px;
    top: -170px;
    right: -90px;
    background: rgb(255 255 255 / 0.07);
  }

  .final-cta__box::after {
    width: 260px;
    height: 260px;
    bottom: -150px;
    left: -70px;
    background: rgb(248 215 122 / 0.16);
  }

  .final-cta__star {
    position: absolute;
    top: 1.5rem;
    left: 1.75rem;
    color: var(--yellow-300);
    opacity: 0.8;
    transform: rotate(-12deg);
  }

  .final-cta h2 {
    position: relative;
    max-width: 820px;
    margin-inline: auto;
    font-size: var(--fs-700);
    color: var(--white);
  }

  .final-cta p {
    position: relative;
    max-width: 640px;
    margin: 0 auto 2rem;
    font-size: var(--fs-500);
    color: rgb(255 255 255 / 0.88);
  }

  .final-cta__actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
  }

  .final-cta__actions :global(.final-cta__secondary) {
    color: var(--white);
  }

  .final-cta__actions :global(.final-cta__secondary:hover) {
    background: rgb(255 255 255 / 0.1);
  }

  @media (max-width: 480px) {
    .final-cta__actions :global(.btn) {
      width: 100%;
    }
  }
</style>
