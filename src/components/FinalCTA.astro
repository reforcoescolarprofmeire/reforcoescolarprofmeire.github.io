---
import Button from './ui/Button.astro';
import { finalCta as data } from '../data/cta';
import { primaryContact, primaryContactLabel, hasWhatsapp } from '../utils/contact';
---

<section class="section final-cta" aria-labelledby="cta-final-titulo">
  <div class="container folha">
    <h2 id="cta-final-titulo" class="final-cta__title">{data.title}</h2>
    <p class="final-cta__text">{data.text}</p>
    <div class="final-cta__actions">
      <Button href={primaryContact.href} external={primaryContact.external} size="lg">
        {primaryContactLabel}
      </Button>
      {
        hasWhatsapp && (
          <Button href="#contato" variant="secondary" size="lg">
            {data.secondaryLabel}
          </Button>
        )
      }
    </div>
  </div>
</section>

<style>
  .final-cta__title {
    font-size: var(--t-4);
    max-width: 22ch;
  }

  .final-cta__text {
    font-size: var(--t-1);
    line-height: 1.5;
    max-width: 52ch;
    margin-bottom: 1.75rem;
  }

  .final-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  @media (max-width: 480px) {
    .final-cta__actions :global(.btn) {
      width: 100%;
    }
  }
</style>
